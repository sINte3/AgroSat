# AgroSat Environment Configuration
# Скопируйте в .env и заполните значения

# ─── Приложение ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
RELEASE_REVISION=
# SECRET_KEY must be a cryptographically random value of at least 32 characters.
# Do not use a known or placeholder value — this is enforced at startup.
SECRET_KEY=

# ─── База данных ──────────────────────────────────────────────────────────────
DATABASE_URL=

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# Collector status directory shared read-only with the API process.
COLLECTOR_STATUS_DIRECTORY=
COLLECTOR_STALE_AFTER_SECONDS=129600

# ─── Sentinel Hub (NDVI из спутников) ────────────────────────────────────────
# Регистрация БЕСПЛАТНО: https://www.sentinel-hub.com/
# После регистрации: Dashboard → User Settings → OAuth Clients → New OAuth Client
# Веб-приложение может импортироваться и запускаться без этих credentials.
# Реальные refresh/collector/backfill записи требуют обе credentials и fail closed.
# Mock values доступны только в явном no-write validation режиме.
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# ─── Регистрация ──────────────────────────────────────────────────────────────
# Public registration is disabled by default.  Set to true only in development.
PUBLIC_REGISTRATION_ENABLED=false

# First pilot: Wialon is deferred to the Integrated Operations pilot wave.
# Enabling the later wave requires a separate authorization and frontend flag.
WIALON_ENABLED=false

# ─── Первоначальная настройка администратора ──────────────────────────────────
# Используется только скриптом seed_data.py для создания первого пользователя.
# Должен быть надёжным паролем (≥16 символов, заглавные+строчные+цифры+спецсимволы).
# Удалите или закомментируйте эту переменную после первого использования.
# НЕ КОММИТЬТЕ значение этой переменной в репозиторий.
AGROSAT_BOOTSTRAP_ADMIN_PASSWORD=

# ─── Настройки алертов ───────────────────────────────────────────────────────
NDVI_DROP_WARNING_THRESHOLD=0.15
NDVI_DROP_CRITICAL_THRESHOLD=0.25
NDVI_FETCH_INTERVAL_HOURS=12

# ─── Примечание ──────────────────────────────────────────────────────────────
# Mock values must never be persisted as production observations.
# Отсутствующие или частичные Sentinel credentials не включают mock автоматически.
