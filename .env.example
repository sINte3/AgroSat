# AgroSat Environment Configuration
# Скопируйте в .env и заполните значения

# ─── Приложение ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
# SECRET_KEY must be a cryptographically random value of at least 32 characters.
# Do not use a known or placeholder value — this is enforced at startup.
SECRET_KEY=

# ─── База данных ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://agrosat:agrosat_secret_2024@localhost:5432/agrosat

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Sentinel Hub (NDVI из спутников) ────────────────────────────────────────
# Регистрация БЕСПЛАТНО: https://www.sentinel-hub.com/
# После регистрации: Dashboard → User Settings → OAuth Clients → New OAuth Client
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# ─── Регистрация ──────────────────────────────────────────────────────────────
# Public registration is disabled by default.  Set to true only in development.
PUBLIC_REGISTRATION_ENABLED=false

# ─── Первоначальная настройка администратора ──────────────────────────────────
# Используется только скриптом seed_data.py для создания первого пользователя.
# Должен быть надёжным паролем (≥16 символов, заглавные+строчные+цифры+спецсимволы).
# Удалите или закомментируйте эту переменную после первого использования.
# НЕ КОММИТЬТЕ значение этой переменной в репозиторий.
AGROSAT_BOOTSTRAP_ADMIN_PASSWORD=

# ─── Настройки алертов ───────────────────────────────────────────────────────
NDVI_DROP_WARNING_THRESHOLD=0.15
NDVI_DROP_CRITICAL_THRESHOLD=0.25
NDVI_FETCH_INTERVAL_HOURS=12

# ─── Примечание ──────────────────────────────────────────────────────────────
# Без Sentinel Hub ключей система работает в MOCK режиме (тестовые данные)
# Это нормально для разработки и демонстрации
