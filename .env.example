# AgroSat Environment Configuration
# Скопируйте в .env и заполните значения

# ─── Приложение ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=замените_на_длинную_случайную_строку_минимум_32_символа

# ─── База данных ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://agrosat:agrosat_secret_2024@localhost:5432/agrosat

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Sentinel Hub (NDVI из спутников) ────────────────────────────────────────
# Регистрация БЕСПЛАТНО: https://www.sentinel-hub.com/
# После регистрации: Dashboard → User Settings → OAuth Clients → New OAuth Client
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# ─── Настройки алертов ───────────────────────────────────────────────────────
NDVI_DROP_WARNING_THRESHOLD=0.15
NDVI_DROP_CRITICAL_THRESHOLD=0.25
NDVI_FETCH_INTERVAL_HOURS=12

# ─── Примечание ──────────────────────────────────────────────────────────────
# Без Sentinel Hub ключей система работает в MOCK режиме (тестовые данные)
# Это нормально для разработки и демонстрации
